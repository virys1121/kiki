digraph G {
    fontname="Helvetica,Arial,sans-serif"
    node [fontname="Helvetica,Arial,sans-serif"]
    edge [fontname="Helvetica,Arial,sans-serif"]
    rankdir=LR;
    node [shape=record];

    Roles [label="{Roles|RoleID (PK)\lRoleName\l}"];
    Users [label="{Users|UserID (PK)\lUserFullName\lUserLogin (U)\lUserPassword\lUserRole (FK)\l}"];
    Products [label="{Products|ProductArticleNumber (PK)\lProductName\lProductDescription\lProductPrice\lProductQuantityInStock\l}"];
    Orders [label="{Orders|OrderID (PK)\lOrderDate\lOrderStatus\lOrderUserID (FK)\l}"];
    OrderItems [label="{OrderItems|OrderID (PK, FK)\lProductArticleNumber (PK, FK)\lItemQuantity\lItemPrice\l}"];

    Roles -> Users [label="1:N"];
    Users -> Orders [label="1:N"];
    Orders -> OrderItems [label="1:N"];
    Products -> OrderItems [label="1:N"];
}
